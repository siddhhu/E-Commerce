# Pranjay Frontend Environment

# API URL — backend host only, NO /api/v1 suffix, NOT the frontend URL
# Local:  http://localhost:8000
# Vercel: https://e-commerce-p21z.vercel.app
# Must be set in Vercel BEFORE build — then redeploy frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: explicit backend URL for SSR/build (same value as above on Vercel)
BACKEND_URL=http://localhost:8000

# App URL (for callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay (public key — safe for client)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_SZO4iQslfD86WW

# Firebase web config (phone OTP login)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
