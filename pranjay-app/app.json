{
  "expo": {
    "name": "Pranjay",
    "slug": "pranjay-app",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pranjayapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pranjay.shop",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["tez", "phonepe", "paytmmp", "gpay"],
        "NSCameraUsageDescription": "Allow Pranjay to use your camera so you can photograph KYC documents.",
        "NSPhotoLibraryUsageDescription": "Allow Pranjay to access your photos so you can upload KYC documents."
      }
    },
    "android": {
      "package": "com.pranjay.shop",
      "versionCode": 8,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFF7FB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withFirebasePhoneAuth",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF7FB"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Pranjay to access your photos so you can upload documents.",
          "cameraPermission": "Allow Pranjay to use your camera to photograph documents.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://e-commerce-p21z.vercel.app"
    }
  }
}
